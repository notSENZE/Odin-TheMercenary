<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>OdinTheMercenary.Client</AssemblyName>
    <RootNamespace>OdinTheMercenary.Client</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NuGetAudit>false</NuGetAudit>

    <SptRoot Condition="'$(SptRoot)' == ''">S:\SPT</SptRoot>
    <SptManagedPath>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManagedPath>
    <SptBepInExPath>$(SptRoot)\BepInEx</SptBepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Prepatch\ClientInfo.cs">
      <Link>ClientInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInExPath)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInExPath)\core\BepInEx.dll</HintPath>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManagedPath)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptManagedPath)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManagedPath)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManagedPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(SptManagedPath)\UnityEngine.AIModule.dll</HintPath>
    </Reference>

    <!-- Required because EFT player types reference IDissonancePlayer -->
    <Reference Include="DissonanceVoip">
      <HintPath>$(SptManagedPath)\DissonanceVoip.dll</HintPath>
    </Reference>

    <Reference Include="DrakiaXYZ-BigBrain">
      <HintPath>$(SptBepInExPath)\plugins\DrakiaXYZ-BigBrain.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-custom">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-custom.dll</HintPath>
    </Reference>
    <Reference Include="spt-singleplayer">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-singleplayer.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>

    <Reference Include="Comfort">
      <HintPath>$(SptManagedPath)\Comfort.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
